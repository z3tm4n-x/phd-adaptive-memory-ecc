# User Generated XDC timing constraints 

current_instance -quiet
set_clock_uncertainty -setup 0.500 [get_clocks *]
set_clock_uncertainty -hold 0.100 [get_clocks *]
set_output_delay -clock [get_clocks -of_objects [get_pins core/clocks/slow/O]] -max 5.000 [get_ports {fault_led locked_led}]
set_output_delay -clock [get_clocks -of_objects [get_pins core/clocks/slow/O]] -min 0.000 [get_ports {fault_led locked_led}]
set_load 5.000 [get_ports {fault_led locked_led}]

# User Generated miscellaneous constraints 

set_property LOAD 5 [get_ports fault_led]
set_property LOAD 5 [get_ports locked_led]

# User Generated XDC timing constraints 

set_input_delay -clock [get_clocks -of_objects [get_pins core/clocks/slow/O]] -max 0.000 [get_ports {qualified_switch loss_switch}]
set_input_delay -clock [get_clocks -of_objects [get_pins core/clocks/slow/O]] -min 0.000 [get_ports {qualified_switch loss_switch}]
set _xlnx_shared_i0 [list [all_registers] [get_cells [list {core/controller/backend/requested_reg[4]} \
          {core/controller/backend/requested_reg[31]} \
          {core/controller/backend/requested_reg[30]} \
          {core/controller/backend/requested_reg[2]} \
          {core/controller/backend/requested_reg[29]} \
          {core/controller/backend/requested_reg[26]} \
          {core/controller/backend/requested_reg[21]} \
          {core/controller/backend/requested_reg[28]} \
          core/controller/backend/is_control_reg \
          core/controller/history/fifo/gnuram_async_fifo.xpm_fifo_base_inst/gen_sdpram.xpm_memory_base_inst/gen_wr_a.gen_word_narrow.mem_reg_0 \
          core/controller/history/fifo/gnuram_async_fifo.xpm_fifo_base_inst/gen_sdpram.xpm_memory_base_inst/gen_wr_a.gen_word_narrow.mem_reg_1 \
          {core/controller/backend_command_reg[18]} \
          {core/controller/backend_command_reg[7]} \
          {core/controller/backend_command_reg[15]} \
          {core/controller/backend_command_reg[13]} \
          {core/controller/backend_command_reg[11]} \
          {core/controller/backend_command_reg[9]} \
          {core/controller/backend_command_reg[8]} \
          {core/controller/backend_command_reg[6]} \
          {core/controller/backend_command_reg[3]} \
          {core/controller/backend_command_reg[2]} \
          {core/controller/backend_command_reg[20]} \
          {core/controller/backend_command_reg[19]} \
          {core/controller/backend_command_reg[17]} \
          {core/controller/backend_command_reg[16]} \
          {core/controller/backend_command_reg[14]} \
          {core/controller/backend_command_reg[12]} \
          {core/controller/backend/requested_reg[6]}]]]
set_max_delay -datapath_only -from [get_ports {sram_err {sram_dq[*]}}] -to $_xlnx_shared_i0 2.500
set_min_delay -from [get_ports {sram_err {sram_dq[*]}}] -to $_xlnx_shared_i0 0.000
set_max_delay -datapath_only -from $_xlnx_shared_i0 -to [get_ports {{sram_a[*]} {sram_dq[*]} sram_ce_n sram_oe_n sram_we_n sram_lb_n sram_ub_n}] 5.000
set_min_delay -from $_xlnx_shared_i0 -to [get_ports {{sram_a[*]} {sram_dq[*]} sram_ce_n sram_oe_n sram_we_n sram_lb_n sram_ub_n}] 0.000

# User Generated miscellaneous constraints 

set_property CONTROL_SET_REMAP ALL [get_cells -hier -regexp .*backend/pad_(ce|oe|we|be)_n_reg.*]
set_property CONTROL_SET_REMAP ENABLE [get_cells -hier -regexp .*calendar/word_due_reg.*]

# Vivado Generated miscellaneous constraints 

#revert back to original instance
current_instance -quiet
